# AnalystFlow AI Environment Configuration
# Copy this file to .env to customize settings

# Application Secret Key
SECRET_KEY=change-this-to-a-secure-random-key

# Database Connection (Default: SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///analystflow.db
# DATABASE_URL=postgresql://user:password@localhost:5432/analystflow

# Maximum File Upload Size in Megabytes
MAX_UPLOAD_MB=50

# AI Provider Configuration (Optional — App functions 100% offline in Demo Mode)
# Supported: "openai" or "gemini"
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# CORS Configuration
CORS_ORIGINS=*
